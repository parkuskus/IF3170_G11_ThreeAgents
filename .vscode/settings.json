{
  "latex-workshop.latex.tools": [
    {
      "name": "latexmk-cd",
      "command": "latexmk",
      "args": [
        "-cd",
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "-pdf",
        "-outdir=%OUTDIR%",
        "%DOC%"
      ]
    }
  ],
  "latex-workshop.latex.recipes": [
    {
      "name": "latexmk (folder sumber)",
      "tools": ["latexmk-cd"]
    }
  ],
  "latex-workshop.latex.recipe.default": "first"
}
